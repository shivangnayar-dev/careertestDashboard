@using System.Security.Claims
@model Auxx.Models.Functions

@{
	ViewData["Title"] = "Edit";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var todaydatetime = DateTime.Now;
	var loggedusername = @User.FindFirst(ClaimTypes.Name)?.Value;
}

<h4>Edit Functions</h4>
<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="Edit">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" asp-for="FunctionId" />
			<div class="form-group">
				<label asp-for="FunctionName" class="control-label"></label>
				<input asp-for="FunctionName" class="form-control" />
				<span asp-validation-for="FunctionName" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="FunctionDescription" class="control-label"></label>
				<input asp-for="FunctionDescription" class="form-control" />
				<span asp-validation-for="FunctionDescription" class="text-danger"></span>
			</div>
			<div class="form-group">
				<input asp-for="UpdatedDate" class="form-control" type="hidden" value="@todaydatetime" />
				<input asp-for="UpdatedBy" class="form-control" type="hidden" value="@loggedusername" />
				<input type="submit" value="Save" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>

<div>
	<a asp-action="Index">Back to List</a>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
