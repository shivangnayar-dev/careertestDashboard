@using System.Security.Claims
@model Auxx.Models.Organizations

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var todaydatetime = DateTime.Now;
    var loggedusername = @User.FindFirst(ClaimTypes.Name)?.Value;
}

<h4> Edit Organizations</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="OrganizationId" />
            <div class="form-group">
                <label asp-for="OrganizationName" class="control-label"></label>
                <input asp-for="OrganizationName" class="form-control" />
                <span asp-validation-for="OrganizationName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CG_SuperAdminEmailId" class="control-label"></label>
                <input asp-for="CG_SuperAdminEmailId" class="form-control" />
                <span asp-validation-for="CG_SuperAdminEmailId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer_SuperAdminEmailId" class="control-label"></label>
                <input asp-for="Customer_SuperAdminEmailId" class="form-control" />
                <span asp-validation-for="Customer_SuperAdminEmailId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer_AdminEmailId1" class="control-label"></label>
                <input asp-for="Customer_AdminEmailId1" class="form-control" />
                <span asp-validation-for="Customer_AdminEmailId1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer_AdminEmailId2" class="control-label"></label>
                <input asp-for="Customer_AdminEmailId2" class="form-control" />
                <span asp-validation-for="Customer_AdminEmailId2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer_AdminEmailId3" class="control-label"></label>
                <input asp-for="Customer_AdminEmailId3" class="form-control" />
                <span asp-validation-for="Customer_AdminEmailId3" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer_AdminEmailId4" class="control-label"></label>
                <input asp-for="Customer_AdminEmailId4" class="form-control" />
                <span asp-validation-for="Customer_AdminEmailId4" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer_AdminEmailId5" class="control-label"></label>
                <input asp-for="Customer_AdminEmailId5" class="form-control" />
                <span asp-validation-for="Customer_AdminEmailId5" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="CreatedDate" class="form-control" type="hidden" />
                <input asp-for="CreatedBy" class="form-control" type="hidden"/>
                <input asp-for="UpdatedDate" class="form-control" type="hidden" value="@todaydatetime" />
                <input asp-for="UpdatedBy" class="form-control" type="hidden" value="@loggedusername" />
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
