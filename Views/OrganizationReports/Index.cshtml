@model IEnumerable<Auxx.Models.OrganizationReportViewModel>

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Reports tagged to organisation </h1>

<p>
	<a asp-action="Create">Create New</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.OrganizationName)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.OrganizationReport.ReportId)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.OrganizationReport.Minimumcostofreport)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.OrganizationReport.MarkuponMinimumcost)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.OrganizationReport.TotalCost)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.OrganizationReport.Contract_Startdate)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.OrganizationReport.Contract_Enddate)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.OrganizationName)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.OrganizationReport.ReportId)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.OrganizationReport.Minimumcostofreport)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.OrganizationReport.MarkuponMinimumcost)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.OrganizationReport.TotalCost)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.OrganizationReport.Contract_Startdate)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.OrganizationReport.Contract_Enddate)
				</td>
				<td>
					<a asp-action="Edit" asp-route-id="@item.OrganizationReport.OrganizationReportId">Edit</a> |
					<a asp-action="Details" asp-route-id="@item.OrganizationReport.OrganizationReportId">Details</a> |
				</td>
			</tr>
		}
	</tbody>
</table>