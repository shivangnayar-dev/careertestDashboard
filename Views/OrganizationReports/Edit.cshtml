@using System.Security.Claims
@model Auxx.Models.OrganizationReportViewModel

@{
	ViewData["Title"] = "Edit";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var todaydatetime = DateTime.Now;
	var loggedusername = @User.FindFirst(ClaimTypes.Name)?.Value;
}
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
	$(document).ready(function () {
		$('#ReportId').change(function () {

			const selectedReportedId = $(this).val();

			if (selectedReportedId) {
				$.get('./GetCost', { reportId: selectedReportedId }, function (data) {
					$('#Minimumcostofreport').val(data);
				});
			} else {
				$('#Minimumcostofreport').val('0.00');
			}
		});
	});
	function updateTotalCost() {
			// Get the markup cost value
			const markupCost = parseFloat(document.getElementById('MarkuponMinimumcost').value) || 0;

			// Get the minimum cost of the report value
			const minimumCost = parseFloat(document.getElementById('Minimumcostofreport').value) || 0;

			// Calculate total cost
			const totalCost = markupCost + minimumCost;

			// Update the total cost input field
			document.getElementById('TotalCost').value = totalCost;
			//document.querySelector("input[type='hidden'][asp-for='TotalCost']").value = totalCost.toFixed(2);;
		}
</script>
<h4>Edit OrganizationReports</h4>
<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="Edit">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" asp-for="OrganizationReport.OrganizationReportId" />
			<div class="form-group">
				<label asp-for="OrganizationReport.ReportId" class="control-label"></label>
				<input asp-for="OrganizationReport.ReportId" class="form-control" readonly />
				<input asp-for="OrganizationReport.ReportId" class="form-control" type="hidden" />
				<span asp-validation-for="OrganizationReport.ReportId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="OrganizationReport.Minimumcostofreport" class="control-label"></label>
				<input asp-for="OrganizationReport.Minimumcostofreport" class="form-control" onblur="updateTotalCost()" />
				<span asp-validation-for="OrganizationReport.Minimumcostofreport" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="OrganizationReport.MarkuponMinimumcost" class="control-label"></label>
				<input asp-for="OrganizationReport.MarkuponMinimumcost" class="form-control" onblur="updateTotalCost()" />
				<span asp-validation-for="OrganizationReport.MarkuponMinimumcost" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="OrganizationReport.TotalCost" class="control-label"></label>
				<input asp-for="OrganizationReport.TotalCost" class="form-control" />
				<span asp-validation-for="OrganizationReport.TotalCost" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="OrganizationReport.Contract_Startdate" class="control-label"></label>
				<input asp-for="OrganizationReport.Contract_Startdate" class="form-control" />
				<span asp-validation-for="OrganizationReport.Contract_Startdate" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="OrganizationReport.Contract_Enddate" class="control-label"></label>
				<input asp-for="OrganizationReport.Contract_Enddate" class="form-control" />
				<span asp-validation-for="OrganizationReport.Contract_Enddate" class="text-danger"></span>
			</div>
			<div class="form-group">
				<input asp-for="OrganizationReport.CreatedDate" class="form-control" type="hidden" />
				<input asp-for="OrganizationReport.CreatedBy" class="form-control" type="hidden"  />
				<input asp-for="OrganizationReport.UpdatedDate" class="form-control" type="hidden" value="@todaydatetime" />
				<input asp-for="OrganizationReport.UpdatedBy" class="form-control" type="hidden" value="@loggedusername" />
				<input type="submit" value="Save" class="text-white btn bg-custom-500 border-custom-500 hover:text-white hover:bg-custom-600 hover:border-custom-600 focus:text-white focus:bg-custom-600 focus:border-custom-600 focus:ring focus:ring-custom-100 active:text-white active:bg-custom-600 active:border-custom-600 active:ring active:ring-custom-100 dark:ring-custom-400/20" />
			</div>
		</form>
	</div>
</div>

<div>
	<a asp-action="Index">Back to List</a>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}