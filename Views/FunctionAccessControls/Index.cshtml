@model IEnumerable<Auxx.Models.FunctionAccessControl>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RoleId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FunctionId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SuperAdmin_CG)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SuperAdmin_Customer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Admin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedBy)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.RoleId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FunctionId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SuperAdmin_CG)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SuperAdmin_Customer)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Admin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedBy)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FunctionAccessId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FunctionAccessId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FunctionAccessId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
