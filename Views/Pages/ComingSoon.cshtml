
@{
    ViewBag.Title = "ComingSoon";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="absolute inset-0 bg-custom-900 opacity-80"></div>
<div class="mb-0 border-none lg:w-[500px] w-full mx-5 lg:mx-0 card bg-white/10 backdrop-blur-lg shadow-none relative">
    <div class="!px-10 !py-12 card-body">
        <div id="countDownText">
            <a href="index">
                <img src="~/assets/images/logo-light.png" alt="" class="h-6 mx-auto">
            </a>

            <div class="mt-8 text-center">
                <h4 class="mb-2 text-white">Coming Soon ...</h4>
                <p class="text-white/75">We'll be here in a brief moment.</p>
            </div>

            <div>
                <div class="mt-8">
                    <div class="flex items-center justify-between mt-14">
                        <div data-countdown="Oct 30, 2025" class="flex flex-wrap gap-3 countdownlist"></div>
                    </div>
                </div>

                <div class="mt-10 text-center">
                    <h5 class="mb-2 text-white">Be alerted when our launch happens.</h5>
                    <p class="mb-5 text-white/75">Don't worry, we won't inundate your inbox 😊</p>
                    <form action="#!" class="relative">
                        <input type="email" id="inputEmail" class="py-3 form-input bg-white/10 border-0 dark:border-zink-500 placeholder:text-white/75 focus-within:outline-none" placeholder="Enter your email" required>
                        <button type="submit" class="px-2.5 py-1.5 text-sm text-white btn bg-custom-500 border-custom-500 hover:text-white hover:bg-custom-600 hover:border-custom-600 focus:text-white focus:bg-custom-600 focus:border-custom-600 active:text-white active:bg-custom-600 active:border-custom-600 absolute top-[5px] ltr:right-1 rtl:left-1">Send</button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>


@section scripts{
    <script src="~/assets/js/pages/pages-coming-soon.init.js"></script>

}
