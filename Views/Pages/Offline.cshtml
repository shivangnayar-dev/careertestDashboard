
@{
    ViewBag.Title = "Offline";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="absolute inset-0 bg-custom-900 opacity-80"></div>
<div class="mb-0 border-none lg:w-[500px] w-full mx-5 lg:mx-0 card bg-white/10 backdrop-blur-lg shadow-none relative">
    <div class="!px-10 !py-12 card-body">
        <a href="index">
            <img src="~/assets/images/logo-light.png" alt="" class="h-6 mx-auto">
        </a>

        <div class="mt-10">
            <img src="~/assets/images/auth/offline.png" alt="" class="mx-auto h-72">
        </div>
        <div class="mt-8 text-center">
            <h4 class="mb-2 text-white">We're Temporarily Offline</h4>
            <p class="mb-6 text-white/75">We can't display these images as you're currently not connected to the internet. Once you're back online, please refresh the page or click the button below.</p>
            <button onclick="window.location.href=window.location.href" class="text-white btn bg-custom-500 border-custom-500 hover:text-white hover:bg-custom-600 hover:border-custom-600 focus:text-white focus:bg-custom-600 focus:border-custom-600 active:text-white active:bg-custom-600 active:border-custom-600"><i data-lucide="refresh-ccw" class="inline-block w-3 h-3 ltr:mr-1 rtl:ml-1"></i> <span class="align-middle">Refresh</span></button>
        </div>
    </div>
</div>
