
@{
    ViewBag.Title = "ResetPasswordCover";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="absolute inset-0 bg-custom-900 opacity-80"></div>
<div class="mb-0 border-none lg:w-[500px] w-full mx-5 lg:mx-0 card bg-white/10 backdrop-blur-lg shadow-none relative">
    <div class="!px-10 !py-12 card-body">
        <a href="index">
            <img src="~/assets/images/logo-light.png" alt="" class="h-6 mx-auto">
        </a>

        <div class="mt-8 text-center">
            <h4 class="mb-2 text-white">Forgot Password?</h4>
            <p class="mb-8 text-white/75">Reset your Auxx password</p>
        </div>

        <div class="px-4 py-3 mb-6 text-sm text-yellow-500 border border-transparent rounded-md bg-yellow-400/20">
            Provide your email address, and instructions will be sent to you
        </div>

        <form autocomplete="off" action="/">
            <div>
                <label for="emailInput" class="inline-block mb-2 text-base font-medium">Email</label>
                <input type="text" class="form-input bg-white/10 border-0 dark:border-zink-500 placeholder:text-white/75 focus-within:outline-none" required placeholder="Enter email" id="emailInput">
            </div>
            <div class="mt-8">
                <button type="submit" class="w-full text-white btn bg-custom-500 border-custom-500 hover:text-white hover:bg-custom-600 hover:border-custom-600 focus:text-white focus:bg-custom-600 focus:border-custom-600 active:text-white active:bg-custom-600 active:border-custom-600">Send Reset Link</button>
            </div>
            <div class="mt-4 text-center">
                <p class="mb-0 text-white/75">Wait, I remember my password... <a href="/auth/logincover" class="underline fw-medium text-white"> Click here </a> </p>
            </div>
        </form>
    </div>
</div>