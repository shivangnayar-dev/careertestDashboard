
@{
    ViewBag.Title = "VerifyEmailCover";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="absolute inset-0 bg-custom-900 opacity-80"></div>
<div class="mb-0 border-none lg:w-[500px] w-full mx-5 lg:mx-0 card bg-white/10 backdrop-blur-lg shadow-none relative">
    <div class="!px-10 !py-12 card-body">
        <a href="index">
            <img src="~/assets/images/logo-light.png" alt="" class="h-6 mx-auto">
        </a>

        <div class="mt-8 text-center">
            <h4 class="mb-1 text-white">Verify Email</h4>
            <p class="mb-4 text-white/75">Did you not receive an email? Please <a href="/" class="text-white">try again</a></p>
            <a href="/" class="px-2 py-1.5 text-xs text-white transition-all duration-200 ease-linear btn bg-custom-500 border-custom-500 hover:text-white hover:bg-custom-600 hover:border-custom-600 focus:text-white focus:bg-custom-600 focus:border-custom-600 active:text-white active:bg-custom-600 active:border-custom-600">Skip Now</a>
        </div>

        <div class="pt-10 text-center">
            <img src="~/assets/images/auth-email.png" alt="" class="block w-2/3 mx-auto">
        </div>
    </div>
</div>
