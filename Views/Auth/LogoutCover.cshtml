
@{
    ViewBag.Title = "LogoutCover";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="absolute inset-0 bg-custom-900 opacity-80"></div>
<div class="mb-0 border-none lg:w-[500px] w-full mx-5 lg:mx-0 card bg-white/10 backdrop-blur-lg shadow-none relative">
    <div class="!px-10 !py-12 card-body">
        <a href="index">
            <img src="~/assets/images/logo-light.png" alt="" class="h-6 mx-auto">
        </a>

        <div class="mt-8 text-center">
            <div class="mb-4 text-center">
                <i data-lucide="log-out" class="w-6 h-6 mx-auto text-yellow-500 fill-yellow-500/20"></i>
            </div>
            <h4 class="mb-2 text-white">You are Logged Out</h4>
            <p class="mb-8 text-white/75">Thank you for using Auxx admin template</p>
        </div>

        <a href="/auth/logincover" class="w-full text-white transition-all duration-200 ease-linear btn bg-custom-500 border-custom-500 hover:text-white hover:bg-custom-600 hover:border-custom-600 focus:text-white focus:bg-custom-600 focus:border-custom-600 active:text-white active:bg-custom-600 active:border-custom-600">Sign In</a>
    </div>
</div>


@section scripts{
    <script src="~/assets/js/pages/auth-two-steps.init.js"></script>

}
